---
/**
 * Sprachumschalter „DE · EN · ES · TR“ – dezent im Stil der Navigation, keine Flaggen.
 * Die aktive Sprache ist unterstrichen (aria-current). Jeder Link trägt lang + hreflang,
 * damit Screenreader die Sprachnamen korrekt aussprechen. Der zugängliche Name enthält
 * das sichtbare Kürzel („DE Deutsch“), damit Sprachsteuerung „DE“ findet (WCAG 2.5.3).
 * Die Ziel-URLs werden in Phase 2 aus der zentralen Slug-Zuordnung berechnet.
 */
interface SprachLink {
  code: string;        // "de" | "en" | "es" | "tr"
  href: string;        // entsprechende Seite in dieser Sprache
  name: string;        // Eigenbezeichnung, z. B. „Türkçe“
}
interface Props {
  aktuell: string;
  links: SprachLink[];
  label: string;       // z. B. „Sprache wählen“ (aus i18n)
  class?: string;
}
const { aktuell, links, label, class: klasse = "" } = Astro.props;
---
<nav aria-label={label} class:list={["sprachumschalter", klasse]}>
  <ul class="flex flex-wrap items-center">
    {links.map((l, i) => (
      <li class="flex items-center">
        {i > 0 && <span aria-hidden="true" class="text-oxblood-muted">·</span>}
        <a
          href={l.href}
          hreflang={l.code}
          lang={l.code}
          aria-current={l.code === aktuell ? "true" : undefined}
          class="nav-link"
        >
          {l.code.toUpperCase()}<span class="sr-only"> {l.name}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
