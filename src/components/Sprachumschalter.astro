---
/**
 * Sprachumschalter „DE · EN · ES · TR“ – dezent im Stil der Navigation, keine Flaggen.
 * - Ziel ist immer die entsprechende Seite der anderen Sprache (aus src/i18n/routen.ts).
 * - Fehlt die Übersetzung, führt der Link zur deutschen Fassung mit Hinweis.
 * - Die aktive Sprache ist unterstrichen (aria-current).
 * - Jeder Link trägt lang + hreflang; der zugängliche Name enthält das sichtbare Kürzel
 *   („DE Deutsch“), damit Sprachsteuerung „DE“ findet (WCAG 2.5.3).
 * - Keine Weiterleitung, kein Cookie: Die Sprache steckt allein in der URL.
 */
import { site, type Sprache } from "../config/site";
import { t, type Alternative } from "../i18n";

interface Props {
  aktuell: Sprache;
  alternativen: Alternative[];
  /** Beschriftung der Navigation, z. B. „Sprache wählen (Fußzeile)“ */
  label?: string;
  class?: string;
}
const { aktuell, alternativen, label, class: klasse = "" } = Astro.props;
---
<nav aria-label={label ?? t(aktuell, "a11y.sprache_waehlen")} class:list={["sprachumschalter", klasse]}>
  <ul class="flex flex-wrap items-center">
    {alternativen.map((a, i) => (
      <li class="flex items-center">
        {i > 0 && <span aria-hidden="true" class="text-oxblood-muted">·</span>}
        <a
          href={a.href}
          hreflang={a.vorhanden ? a.sprache : site.sprachen.standard}
          lang={a.sprache}
          aria-current={a.sprache === aktuell ? "true" : undefined}
          class="nav-link"
        >
          {a.sprache.toUpperCase()}<span class="sr-only"> {site.sprachen.bezeichnungen[a.sprache]}{!a.vorhanden && ` – ${t(a.sprache, "sprachen.nur_deutsch")}`}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
