---
/**
 * Schlanke, fixierte Leiste unten – nur auf dem Handy.
 * Cream Paper, 1px-Oxblood-Haarlinie oben, kleine Labels:
 * Online-Termin · Anrufen · Anfahrt. Kein WhatsApp (Gesundheitsdaten, DSGVO).
 */
interface Eintrag { href: string; label: string; extern?: boolean; externHinweis?: string }
interface Props { eintraege: Eintrag[]; label: string }
const { eintraege, label } = Astro.props;
---
<nav
  aria-label={label}
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink bg-paper pb-[env(safe-area-inset-bottom)] md:hidden"
>
  <ul class="grid" style={`grid-template-columns: repeat(${eintraege.length}, minmax(0, 1fr));`}>
    {eintraege.map((e, i) => (
      <li class:list={[i > 0 && "border-l border-ink"]}>
        <a
          href={e.href}
          target={e.extern ? "_blank" : undefined}
          rel={e.extern ? "noopener" : undefined}
          class="label flex min-h-14 tracking-[0.03em] items-center justify-center px-2 text-center no-underline"
        >
          {e.label}
          {e.extern && e.externHinweis && <span class="sr-only"> ({e.externHinweis})</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>
